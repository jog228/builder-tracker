{
  "name": "builder-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "groupme:list-groups": "tsx --conditions=react-server --env-file=.env.local scripts/list-groups.ts",
    "groupme:backfill": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-groupme.ts",
    "groupme:sync": "tsx --conditions=react-server --env-file=.env.local scripts/sync-groupme.ts",
    "groupme:purge-raw": "tsx --conditions=react-server --env-file=.env.local scripts/purge-groupme-raw.ts",
    "db:push": "supabase db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "set-exec": "tsx --conditions=react-server --env-file=.env.local scripts/set-exec.ts",
    "score-messages": "tsx --conditions=react-server --env-file=.env.local scripts/score-messages.ts",
    "eval:classifier": "tsx --conditions=react-server --env-file=.env.local scripts/eval-classifier.ts",
    "flag-shipped": "tsx --conditions=react-server --env-file=.env.local scripts/flag-shipped.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
