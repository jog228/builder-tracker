# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# GroupMe (https://dev.groupme.com → Access Token)
GROUPME_TOKEN=
GROUPME_GROUP_ID=

# Anthropic (message scoring)
ANTHROPIC_API_KEY=

# GitHub fine-grained read-only token (Phase 5)
GITHUB_TOKEN=

# Long random string; protects /api/cron/* routes
CRON_SECRET=
